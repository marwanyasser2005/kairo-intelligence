GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Ordered free-model pools. The gateway automatically advances to the next
# model on 404, quota limits, timeouts, or transient upstream errors.
GEMINI_TEXT_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_JSON_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemma-4-31b-it,gemma-4-26b-a4b-it
GEMINI_VISION_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=30000
GEMINI_TOTAL_TIMEOUT_MS=80000
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_THINKING_BUDGET=0

# Optional server-only AgentRouter fallback. Keep the API key in the hosting
# platform's encrypted environment store; never prefix it with VITE_.
AI_ENABLE_AGENTROUTER_FALLBACK=false
AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://co.agentrouter.org/v1
AGENTROUTER_MODELS=gpt-5.5,glm-5.1
AGENTROUTER_VISION_MODELS=
AGENTROUTER_TIMEOUT_MS=45000

# Optional server-only TaBiAI fallback. Current catalogue entries are chat-only.
AI_ENABLE_TABIAI_FALLBACK=false
TABIAI_API_KEY=
TABIAI_BASE_URL=https://tabitoken.com/v1
TABIAI_MODELS=claude-opus-5-thinking,claude-opus-5,claude-opus-4-8-thinking,claude-opus-4-8
TABIAI_VISION_MODELS=
TABIAI_TIMEOUT_MS=60000

# Optional legacy fallback. It is disabled by default because the current
# TokenRouter free model is too slow for Kairo's large structured reports.
AI_ENABLE_TOKENROUTER_FALLBACK=false
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODELS=z-ai/glm-5.2-free
TOKENROUTER_VISION_MODELS=
TOKENROUTER_TIMEOUT_MS=30000

AI_RATE_LIMIT_PER_MINUTE=60
# Comma-separated extra browser origins allowed to call the AI gateway.
# Same-origin requests are always accepted. Leave empty in normal production.
AI_ALLOWED_ORIGINS=
# Set only when Express is directly behind a trusted reverse proxy. This controls
# which proxy hop may supply the client IP used for rate limiting.
AI_TRUST_PROXY_HOPS=0
PORT=3000

# Supabase browser connection. Use the publishable/anon key only; never expose
# a service-role key to Vite or the browser.
# Set false to use resilient current-device storage without making cloud calls.
VITE_SUPABASE_CLOUD_ENABLED=true
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may expose this public anon JWT instead. Prefer the newer
# publishable key. Neither value can run SQL migrations or bypass RLS.
VITE_SUPABASE_ANON_KEY=
