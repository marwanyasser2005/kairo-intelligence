{
  "name": "kairo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner && tsx scripts/generateSeoAssets.ts && vite build --config vite.sites.config.ts --configLoader runner && node prepareSitesBuild.mjs",
    "start": "tsx server.ts --prod",
    "preview": "tsx server.ts --prod",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/tokenRouter.test.ts tests/agentRouter.test.ts tests/tabiGateway.test.ts tests/geminiGateway.test.ts tests/earlyWarning.test.ts tests/scenarioLab.test.ts tests/security.test.ts tests/supabase.test.ts tests/uiSystem.test.ts tests/seo.test.ts tests/impactVerification.test.ts tests/calculations.test.ts tests/dashboardLogic.test.ts tests/tariffEngine.test.ts tests/displayLabels.test.ts tests/billExtraction.test.ts tests/capabilityTiers.test.ts tests/foodFacts.test.ts tests/mobilityFacts.test.ts tests/supabaseBootstrap.test.ts",
    "verify:gemini": "tsx scripts/verifyGemini.ts",
    "verify:kairo-ai": "tsx scripts/verifyKairoGemini.ts",
    "verify:tokenrouter": "tsx scripts/verifyTokenRouter.ts",
    "verify:tabiai": "tsx scripts/verifyTaBiAI.ts",
    "verify:supabase": "tsx scripts/verifySupabase.ts",
    "supabase:bootstrap": "tsx scripts/generateSupabaseBootstrap.ts",
    "verify:seo": "tsx scripts/verifySeo.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "html2canvas-pro": "2.3.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.474.0",
    "motion-dom": "^12.40.0",
    "motion-utils": "^12.39.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.22.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0"
  }
}
