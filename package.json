  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build --configLoader runner && vite build --config vite.sites.config.ts --configLoader runner && node prepareSitesBuild.mjs",
    "start": "tsx server.ts --prod",
    "preview": "tsx server.ts --prod",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/tokenRouter.test.ts tests/geminiGateway.test.ts tests/earlyWarning.test.ts tests/scenarioLab.test.ts",
    "verify:gemini": "tsx scripts/verifyGemini.ts",
    "verify:kairo-ai": "tsx scripts/verifyKairoGemini.ts",
    "verify:tokenrouter": "tsx scripts/verifyTokenRouter.ts"
  },
  "dependencies": {
    "@heroui/react": "^3.2.2",
    "@heroui/styles": "^3.2.2",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/vite": "^4.3.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^12.40.0",
    "html2canvas-pro": "2.3.2",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "0.474.0",
    "motion-dom": "^12.40.0",
    "motion-utils": "^12.39.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
